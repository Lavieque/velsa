# Copy to .env.local for development and set the same names in Vercel.

# Cloudflare Turnstile (dash.cloudflare.com -> Turnstile).
# Without these, dev uses Cloudflare's always-pass test keys; production fails closed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (resend.com -> API Keys). The sending domain must be verified there.
RESEND_API_KEY=
# Optional. Defaults: to = geral@velsadigital.com, from = "Velsa Digital <noreply@velsadigital.com>".
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Cloudflare Web Analytics token (Cloudflare -> Analytics & Logs -> Web Analytics). Public by design.
# Leave empty locally: no beacon is rendered.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
